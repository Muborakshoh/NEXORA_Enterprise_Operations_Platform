# Режим разработки: Vite с горячей перезагрузкой.
FROM node:22-alpine

WORKDIR /app

# Зависимости ставятся в образ, чтобы при старте не ждать каждый раз.
COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY . .

EXPOSE 3000

# --host обязателен: без него Vite слушает только 127.0.0.1 внутри контейнера
# и снаружи недоступен.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
